# Lean QEMU test-harness runtime for qemu-test.sh: no rust/sbsign/kernel toolchain,
# just the qemu/swtpm layer needed to boot a disk and mock the metadata service.
# Pinned by digest (multi-arch index): the OVMF/AAVMF CODE images here are what boot the varstores
# tools/mkvarstore.py lays out for bookworm's pflash geometry, so the firmware must not drift.
# Published multi-arch (linux/amd64 + linux/arm64) to ghcr on stage0-v* tags, alongside the
# stage0 release it was built with.
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

RUN apt-get -qq update && \
    apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    qemu-system-arm \
    ovmf \
    qemu-efi-aarch64 \
    swtpm \
    swtpm-tools \
    tpm2-tools \
    xxd \
    dnsmasq \
    iproute2 \
    iptables \
    python3 \
    curl \
    ca-certificates \
    openssl \
    tcpdump && \
    rm -rf /var/lib/apt/lists/*

# Pre-bake the EC2 metadata mock for the image's arch so make/CI runs don't download into the
# bind-mounted repo. qemu-test.sh checks EC2_MOCK_CACHE (set to /opt by the Makefile) before
# falling back to its own download; hashes match the ones in qemu-test.sh.
ARG TARGETARCH
ARG AEMM_VERSION=v1.13.0
ARG AEMM_SHA256_amd64=4f89ddc71ac53ce540bda1f9c340526d558eed8e41349761f2798acf1b254950
ARG AEMM_SHA256_arm64=9dae5b5849365dbaa133309da81f49bafe94ec0aa7e6b05ce3eb7a8f151c2217
RUN case "${TARGETARCH}" in \
      amd64) sha="${AEMM_SHA256_amd64}" ;; \
      arm64) sha="${AEMM_SHA256_arm64}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    f=/opt/ec2-metadata-mock-linux-${TARGETARCH} && \
    curl -fsSL -o "$f" \
      "https://github.com/aws/amazon-ec2-metadata-mock/releases/download/${AEMM_VERSION}/ec2-metadata-mock-linux-${TARGETARCH}" && \
    echo "${sha}  $f" | sha256sum -c - && \
    chmod +x "$f"

# The mock is baked at /opt; point the entrypoint script at it by default.
ENV EC2_MOCK_CACHE=/opt
# This image only ever runs inside a throwaway container, where qemu-test.sh's
# NAT/iptables setup is safe; bake the acknowledgement so callers don't have to.
ENV YES_INSIDE_DOCKER_DO_DANGEROUS_IPTABLES=1

# Bake the harness script in as the entrypoint so the image is self-contained:
# `docker run ... lockboot:harness --kind stage0 --boot-disk ...` just works.
COPY tools/qemu-test.sh /usr/local/bin/qemu-test.sh
RUN chmod +x /usr/local/bin/qemu-test.sh

WORKDIR /src
ENTRYPOINT ["/usr/local/bin/qemu-test.sh"]
